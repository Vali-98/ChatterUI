{
  "name": "chatterui",
  "main": "expo-router/entry",
  "version": "0.8.8",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "postinstall": "patch-package",
    "lint": "eslint app components screens db lib --ignore-pattern db/migrations",
    "lint:fix": "eslint app components screens db lib --ignore-pattern db/migrations --fix",
    "prebuild": "cross-env APP_VARIANT=development expo prebuild --clean",
    "prebuild:android": "cross-env APP_VARIANT=development expo prebuild --clean --platform android",
    "dev:android": "cross-env APP_VARIANT=development expo run:android",
    "dev:ios": "cross-env APP_VARIANT=development expo run:ios",
    "migrate": "npx drizzle-kit generate",
    "patchsql": "npx patch-package expo-sqlite --exclude \"\\.project|\\.cxx|\\.c|\\.h|build|bin\" --case-sensitive-path-filtering",
    "patchfetch": "npx patch-package expo --include '\".*fetch\\.ts$|.*NativeResponse\\.kt$\"'",
    "patchfs": "npx patch-package expo-file-system --include \"\\.kt$\""
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^expo-modules-core(|/.*)$": "<rootDir>/node_modules/expo-modules-core$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/flash-list))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.1",
    "@react-native-vector-icons/ant-design": "^13.1.2",
    "@react-native-vector-icons/common": "^13.0.1",
    "@react-native-vector-icons/material-icons": "^13.1.2",
    "@react-native-vector-icons/octicons": "^21.1.2",
    "@shopify/flash-list": "~2.3.2",
    "@vali98/react-native-cpu-info": "^0.2.0",
    "@vali98/react-native-fs": "^0.2.4",
    "@vali98/react-native-markdown-display": "^0.1.6",
    "@vali98/react-native-png-utils": "^0.3.0",
    "@vali98/react-native-process-text": "^0.1.3",
    "cui-llama.rn": "^1.13.0",
    "drizzle-orm": "^0.45.2",
    "expo": "^58.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.19",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-screen-orientation": "~58.0.4",
    "expo-sharing": "~58.0.24",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.0.10",
    "lodash.merge": "^4.6.2",
    "mime": "^4.0.7",
    "ratex-react-native": "^0.1.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.88.1",
    "react-native-background-actions": "^4.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.0.0-beta.12",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-simple-toast": "^3.2.0",
    "react-native-worklets": "0.13.0",
    "react-native-zip-archive": "^9.5.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/config-plugins": "~58.0.14",
    "@types/jest": "30.0.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^25.8.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~58.0.27",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-internal": "file:./eslint",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "patch-package": "^8.0.0",
    "prettier": "^3.2.4",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "vali-markdown": {
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "json",
      "html",
      "css",
      "markdown",
      "yaml",
      "go",
      "java",
      "javascript",
      "python",
      "c",
      "rust",
      "bash",
      "typescript",
      "tsx",
      "cpp"
    ]
  },
  "private": true
}
