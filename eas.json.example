{
    "cli": {
        "version": ">= 12.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "distribution": "internal",
            "android": {
                "gradleCommand": ":app:assembleDebug"
            },
            "ios": {
                "buildConfiguration": "Debug"
            },
            "env": {
                "APP_VARIANT": "development",
                "EXPO_PUBLIC_DISTRIBUTION": "direct"
            }
        },
        "preview": {
            "distribution": "internal"
        },
        "preview2": {
            "android": {
                "gradleCommand": ":app:assembleRelease"
            }
        },
        "production": {
            "android": {
                "buildType": "apk"
            },
            "env": {
                "ANDROID_SDK_ROOT": "/point this to your Android SDK directory",
                "APP_VARIANT": "production",
                "EXPO_PUBLIC_DISTRIBUTION": "direct"
            },
            "autoIncrement": true
        },
        "play": {
            "extends": "production",
            "distribution": "store",
            "env": {
                "APP_VARIANT": "production",
                "EXPO_PUBLIC_DISTRIBUTION": "googlePlay"
            },
            "android": {
                "buildType": "app-bundle",
                "gradleCommand": ":app:bundleRelease -PreactNativeArchitectures=arm64-v8a"
            }
        }
    },
    "submit": {
        "production": {},
        "play": {}
    }
}
